# Frontend environment.
#
# Copy to `.env.local` and fill in. `.env.local` is git-ignored; this template is
# committed, so it must never contain a real value.
#
# Every `VITE_*` variable is inlined into the JavaScript bundle at build time.
# That is fine for the three below — they are all public — and it is the reason
# there is no service-role key anywhere in this file or in this application.

# Base URL of the backend HTTP API.
VITE_BACKEND_URL=http://127.0.0.1:8000

# --- Supabase Auth (signup and login) -----------------------------------------
#
# The fact-checker works with no account and needs none of these. Without them
# /login and /signup mount, say plainly that accounts are not configured on this
# deployment, and refuse to submit — rather than pretending.
#
# Both values are public. Supabase's row level security is what protects data;
# the anon key only ever grants the anonymous role.
#
# Project URL: Supabase dashboard -> Project Settings -> API -> Project URL
VITE_SUPABASE_URL=

# Publishable key (preferred, `sb_publishable_...`) or legacy anon key.
# Supabase dashboard -> Project Settings -> API -> Publishable key.
#
# NEVER put a `sb_secret_...` key or a service-role JWT here. Both bypass row
# level security, which would hand every visitor the whole database.
# `src/lib/supabase.ts` refuses to start if it is given one.
VITE_SUPABASE_ANON_KEY=
