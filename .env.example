# ---------------------------------------------------------------------------
# Live Fact-Checker backend - example environment
#
# Copy to `.env` and fill in real values. `.env` is git-ignored; never commit
# real credentials. All secrets stay server-side and are never sent to the
# browser. `GET /health` only reports whether a key is present, never its value.
# ---------------------------------------------------------------------------

# --- Service ---------------------------------------------------------------
APP_NAME="Live Fact-Checker Backend"
APP_VERSION="0.1.0"

# development | production | test
ENVIRONMENT=development

# --- HTTP server -----------------------------------------------------------
HOST=127.0.0.1
PORT=8000

# --- CORS ------------------------------------------------------------------
# Comma-separated list of allowed browser origins. There is deliberately no
# "*" default: a wildcard is rejected when ENVIRONMENT=production.
# Add your deployed frontend origin here, e.g. https://my-app.vercel.app
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# --- Logging ---------------------------------------------------------------
# CRITICAL | ERROR | WARNING | INFO | DEBUG
LOG_LEVEL=INFO

# true emits machine-readable JSON logs, recommended for deployment
LOG_JSON=false

# --- Engine wiring ---------------------------------------------------------
# true  -> deterministic MockClaimEngine + MockVerificationEngine (no API keys)
# false -> real modules. Claim extraction still emits structured
#          CLAIM_EXTRACTION_FAILED events until Atif's module is integrated;
#          verification runs through the existing `verification` package and
#          needs no further configuration.
USE_MOCK_ENGINES=true

# --- Credentials (server-side only) ----------------------------------------
# Tushar: AssemblyAI realtime streaming STT
ASSEMBLYAI_API_KEY=

# Atif: claim extraction via the AssemblyAI LLM Gateway
LLM_GATEWAY_API_KEY=
LLM_GATEWAY_BASE_URL=https://llm-gateway.assemblyai.com/v1
LLM_GATEWAY_MODEL=qwen3.5-4b-32k-fast

# Nayanika: evidence retrieval / web search provider (Atif also consumes this)
# `tavily` is the only registered adapter. It needs this one key and nothing
# else. In real mode (USE_MOCK_ENGINES=false) a missing key is reported per
# claim as a structured VERIFICATION_FAILED event; mock evidence is never
# substituted, so a fact-checker verdict is always backed by real retrieval.
SEARCH_API_KEY=
SEARCH_PROVIDER=tavily
